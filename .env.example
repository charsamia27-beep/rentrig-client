# ---------- Public (exposed to the browser) ----------
# Express API (rentrig-server) base URL – no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:5000
# imgbb API key – https://api.imgbb.com/
NEXT_PUBLIC_IMGBB_KEY=your_imgbb_key

# ---------- Server only (Better Auth) ----------
# This app's own URL (used for auth callbacks and as JWT issuer)
BETTER_AUTH_URL=http://localhost:3000
# generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# MongoDB – must be the SAME database the server uses
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rentrigDB

# Google OAuth – redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Optional: one-click demo logins on the login page (examiner convenience) ----------
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_OWNER_EMAIL=
NEXT_PUBLIC_DEMO_OWNER_PASSWORD=
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=
